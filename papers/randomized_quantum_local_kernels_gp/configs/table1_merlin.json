{
  "description": "MerLin photonic ADAPTATION (not the paper's method) of the Table I protocol: 128 Sobol-sampled linear-optical circuits (12 modes, 4 photons, 4 re-uploading layers, nearest-neighbour beam-splitter brickwork), local click-parity features from 10000 postselected threshold-detection events per input, authors' MKL protocol including the shared-noise quirk; paired with qubit sweep S5.",
  "experiment": {
    "task": "gp_mkl",
    "name": "table1_merlin"
  },
  "data": {
    "num_points": 500,
    "seed": 12345,
    "query_kernels": [
      {
        "name": "rbf",
        "type": "rbf",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "matern32",
        "type": "matern32",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "nonstat_ls",
        "type": "nonstat_ls",
        "params": {
          "ell_min": 0.1,
          "ell_max": 0.8,
          "c": 2.0,
          "sigmoid_sign": 1
        }
      }
    ]
  },
  "circuit": {
    "num_draws": 128,
    "sobol_seed": 12345
  },
  "features": {
    "backend": "merlin_photonic",
    "mode": "photon_sampled",
    "num_snapshots": 10000,
    "num_groups": null,
    "seed": 123
  },
  "mkl": {
    "gradient": "lowrank_hutchinson",
    "max_iterations": 400,
    "tolerance": 0.0001,
    "coordinate_rounds": 3,
    "initial_noise_variance": 1.0,
    "fit_noise_variance": true,
    "approx_rank": 32,
    "hutchinson_probes": 16,
    "approx_seed": 1028,
    "noise_coupling": "authors_shared"
  },
  "evaluation": {
    "save_features": true
  },
  "photonic": {
    "num_modes": 12,
    "num_photons": 4,
    "num_layers": 4,
    "detector": "threshold"
  }
}
