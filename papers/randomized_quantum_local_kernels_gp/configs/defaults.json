{
  "description": "Lightweight smoke defaults: the paper pipeline at reduced size (M = 60, R = 8, N = 400 snapshots, 20 logit iterations). Not a paper reproduction; see configs/table1_original.json.",
  "seed": 12345,
  "dtype": "float64",
  "device": "cpu",
  "outdir": "outdir",
  "experiment": {
    "task": "gp_mkl",
    "name": "smoke_defaults"
  },
  "data": {
    "num_points": 60,
    "input_dim": 1,
    "noise_variance": 0.002,
    "train_fraction": 0.75,
    "seed": 12345,
    "cache": false,
    "query_kernels": [
      {
        "name": "rbf",
        "type": "rbf",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "matern32",
        "type": "matern32",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "nonstat_ls",
        "type": "nonstat_ls",
        "params": {
          "ell_min": 0.1,
          "ell_max": 0.8,
          "c": 2.0,
          "sigmoid_sign": 1
        }
      }
    ]
  },
  "circuit": {
    "num_qubits": 4,
    "num_layers": 4,
    "num_draws": 8,
    "sobol_seed": 12345,
    "input_scale": 1.0
  },
  "features": {
    "mode": "code_gaussian",
    "num_snapshots": 400,
    "num_groups": null,
    "seed": 123,
    "backend": "qubit_statevector"
  },
  "mkl": {
    "gradient": "lowrank_hutchinson",
    "max_iterations": 20,
    "tolerance": 0.0001,
    "coordinate_rounds": 3,
    "initial_noise_variance": 1.0,
    "fit_noise_variance": true,
    "approx_rank": 8,
    "hutchinson_probes": 16,
    "approx_seed": 1028,
    "optimizer": "authors_protocol",
    "noise_coupling": "per_kernel"
  },
  "evaluation": {
    "controls": true,
    "figures": true,
    "save_features": false
  },
  "photonic": {
    "num_modes": 12,
    "num_photons": 4,
    "num_layers": 4,
    "detector": "threshold",
    "initial_mixing": "none"
  },
  "classical": {
    "num_features": 24,
    "lengthscale_range": [
      0.02,
      2.0
    ]
  },
  "parametric": {
    "family": "true",
    "restarts": 10
  }
}
