{
  "description": "Table I exactly as the authors' code runs it: table1_original plus the authors' shared-noise quirk (during logit ascent all GPs use one shared noise variance, overwritten by each GP's grid search, so rounds 2-3 use the last GP's value).",
  "experiment": {
    "task": "gp_mkl",
    "name": "table1_original_sharednoise"
  },
  "data": {
    "num_points": 500,
    "seed": 12345,
    "query_kernels": [
      {
        "name": "rbf",
        "type": "rbf",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "matern32",
        "type": "matern32",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "nonstat_ls",
        "type": "nonstat_ls",
        "params": {
          "ell_min": 0.1,
          "ell_max": 0.8,
          "c": 2.0,
          "sigmoid_sign": 1
        }
      }
    ]
  },
  "circuit": {
    "num_draws": 128,
    "sobol_seed": 12345
  },
  "features": {
    "mode": "code_gaussian",
    "num_snapshots": 10000,
    "num_groups": null,
    "seed": 123
  },
  "mkl": {
    "gradient": "lowrank_hutchinson",
    "max_iterations": 400,
    "tolerance": 0.0001,
    "coordinate_rounds": 3,
    "initial_noise_variance": 1.0,
    "fit_noise_variance": true,
    "approx_rank": 32,
    "hutchinson_probes": 16,
    "approx_seed": 1028,
    "noise_coupling": "authors_shared"
  },
  "evaluation": {
    "save_features": true
  }
}
