{
  "description": "Table I pipeline with a true single-qubit Pauli classical-shadow simulation (N = 10000 snapshots per (draw, input), 16 MoM groups, seed 123) instead of the code's Gaussian noise model; tests the paper's classical-shadow claim.",
  "experiment": {
    "task": "gp_mkl",
    "name": "table1_pauli_shadow"
  },
  "data": {
    "num_points": 500,
    "seed": 12345,
    "query_kernels": [
      {
        "name": "rbf",
        "type": "rbf",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "matern32",
        "type": "matern32",
        "params": {
          "lengthscale": 0.3
        }
      },
      {
        "name": "nonstat_ls",
        "type": "nonstat_ls",
        "params": {
          "ell_min": 0.1,
          "ell_max": 0.8,
          "c": 2.0,
          "sigmoid_sign": 1
        }
      }
    ]
  },
  "circuit": {
    "num_draws": 128,
    "sobol_seed": 12345
  },
  "features": {
    "mode": "pauli_shadow",
    "num_snapshots": 10000,
    "num_groups": null,
    "seed": 123
  },
  "mkl": {
    "gradient": "lowrank_hutchinson",
    "max_iterations": 400,
    "tolerance": 0.0001,
    "coordinate_rounds": 3,
    "initial_noise_variance": 1.0,
    "fit_noise_variance": true,
    "approx_rank": 32,
    "hutchinson_probes": 16,
    "approx_seed": 1028
  },
  "evaluation": {
    "save_features": true
  }
}
